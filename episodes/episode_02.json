   "id": "s138",
   "type": "target",
   "lang": "ro",
   "voice": "ro_male",
   "text": "Ba da.",
   "rate": 0.8,
   "pause_after_ms": 1400
  },
  {
   "id": "s139",
   "type": "narration",
   "lang": "en",
   "voice": "en_narrator",
   "text": "Answering just da to a negative question is confusing. Use ba da.",
   "rate": 1.0,
   "pause_after_ms": 1000
  },
  {
   "id": "s140",
   "type": "narration",
   "lang": "en",
   "voice": "en_narrator",
   "text": "The part that is not from the book. Bucharest, not Chișinău, and how people actually talk.",
