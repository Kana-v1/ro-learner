  {
   "id": "s135",
   "type": "narration",
   "lang": "en",
   "voice": "en_narrator",
   "text": "The question was negative: aren't you from the city. In English you answer 'yes' and hope to be understood, because yes is ambiguous there. Romanian has a dedicated word: ba da, meaning 'no — on the contrary, I am'. French does the same thing with si.",
   "rate": 1.0,
   "pause_after_ms": 600
  },
  {
   "id": "s136",
   "type": "target",
   "lang": "ro",
   "voice": "ro_male",
   "text": "Ba da.",
   "rate": 1.0,
   "pause_after_ms": 1400
  },
  {
   "id": "s137",
   "type": "gloss",
   "lang": "en",
   "voice": "en_narrator",
   "text": "Yes I am — contradicting a negative question.",
   "rate": 1.0,
   "pause_after_ms": 400
  },
