   "pause_after_ms": 1400
  },
  {
   "id": "s094",
   "type": "narration",
   "lang": "en",
   "voice": "en_narrator",
   "text": "You just heard two little words doing the same job: un and o. Both mean 'a'. Which one you use depends on the gender of the noun.",
   "rate": 1.0,
