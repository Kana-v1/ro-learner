   "rate": 1.0,
   "pause_after_ms": 1800
  },
  {
   "id": "s023",
   "type": "narration",
   "lang": "en",
   "voice": "en_narrator",
   "text": "I study, I work. That's next lesson. The other groups have endings of their own, and each comes with its own lesson.",
