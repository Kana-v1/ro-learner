   "spoken": "apartamentu', dormitoru', frigideru', dulapu', ziaru'",
   "gloss": "the apartment, the bedroom, the fridge, the wardrobe, the newspaper",
   "note": "The dropped final -l from earlier lessons, now on this chapter's masculine and neuter nouns. Feminine -a stays put: camera, baia, oglinda.",
   "confidence": "high"
  },
  {
   "type": "register_scale",
   "book": "casă",
   "spoken": "apartament / bloc (vs. casă)",
   "gloss": "house vs. flat",
   "note": "'Acasă' means home, wherever that is — but most city people live in an 'apartament' in a 'bloc' (an apartment building), not a detached 'casă'. 'Casă' still doubles as home/household in fixed phrases (la mine acasă), so 'merg acasă' is 'I'm going home' even when home is a flat.",
   "confidence": "high"
  }
